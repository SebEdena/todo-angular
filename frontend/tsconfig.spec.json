{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "./out-tsc/spec",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "types": ["vitest/globals"],
    "paths": {
      "src/*": ["./*"]
    },
    "target": "es2016"
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
  "files": ["src/test-setup.ts"]
}
